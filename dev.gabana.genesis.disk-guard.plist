<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Genesis disk guard. Every 15 minutes: warn at 3 GB free, stop q5 cleanly at 1 GB.
  q5 grows 6.1 GB/day against ~6 GB free, so without this the disk fills in under a day and
  the recording dies mid-write with a broken checkpoint.
  StartInterval rather than StartCalendarInterval: this needs a cadence, not a clock.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.gabana.genesis.disk-guard</string>
    <key>ProgramArguments</key>
    <array><string>/Users/gabana/genesis/disk-guard.sh</string></array>
    <key>WorkingDirectory</key>
    <string>/Users/gabana/genesis</string>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/gabana/genesis-evidence/disk-guard.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gabana/genesis-evidence/disk-guard.launchd.log</string>
</dict>
</plist>
