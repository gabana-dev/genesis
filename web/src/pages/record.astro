---
import Base from '../layouts/Base.astro';
import Grid from '../components/Grid.astro';
import Note from '../components/Note.astro';
import Stat from '../components/Stat.astro';
import { abs, scorecard } from '../lib/data';

const sc = scorecard();
const counts = Object.entries(sc.counts).sort(([a], [b]) => a.localeCompare(b));

// The record's job for a retrieval system is to hand over the structured file, not to restate it
// in markup. `distribution` is the whole point: every claim, its status and its method, in JSON.
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Isobath research record',
  description:
    'Every claim Isobath has published, with its status, sample and method — including the ones we refuted ourselves.',
  dateModified: sc.generated_at,
  variableMeasured: Object.entries(sc.counts).map(([name, value]) => ({
    '@type': 'PropertyValue', name, value,
  })),
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: abs('data/scorecard.json'),
  },
};
---

<Base
  title="Our record — Isobath"
  description="Every claim Isobath has published, including the ones we refuted ourselves."
  jsonld={jsonld}
>
  <h1>Our record</h1>
  <p class="lede">
    Every claim Isobath has published, and what happened to it. Refuted findings are never
    removed — a record that keeps only its wins is a marketing page.
  </p>

  <Grid>
    {counts.map(([k, v]) => <Stat k={k} v={String(v)} />)}
  </Grid>

  <Note>
    Two of these were claims we made confidently and then disproved ourselves. They are the entries
    a competitor will not reproduce, because doing so means publishing when you were wrong.
  </Note>

  <ul class="plain">
    {sc.findings.map((f) => (
      <li>
        <span class={`tag ${f.status}`}>{f.status}</span>&nbsp; <strong>{f.title}</strong><br />
        <span style="color:var(--ink-faint);font-size:.85rem">{f.observation ?? ''}</span>
      </li>
    ))}
  </ul>
</Base>
