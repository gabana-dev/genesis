---
import Base from '../../layouts/Base.astro';
import Answer from '../../components/Answer.astro';
import Grid from '../../components/Grid.astro';
import Note from '../../components/Note.astro';
import Prov from '../../components/Prov.astro';
import Scroll from '../../components/Scroll.astro';
import Stat from '../../components/Stat.astro';
import { age, marketMap, signed, url, usd } from '../../lib/data';

const m = marketMap();
const { totals: t, coverage: cov } = m;
const near = m.clusters[0]!;
const widest = Math.max(...m.clusters.map((c) => c.notional_usd));

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Hyperliquid BTC forced-selling exposure',
  dateModified: m.generated_at,
  temporalCoverage: m.map_taken_at,
  measurementTechnique: 'per-wallet clearinghouse state; coverage stated',
  variableMeasured: Object.entries(t).map(([name, value]) => ({
    '@type': 'PropertyValue', name, value,
  })),
};
---

<Base
  title="BTC liquidation risk on Hyperliquid — Isobath"
  description={`${t.cannot_defend_pct}% of ${usd(t.forced_notional_usd)} in forced BTC exposure cannot defend itself. Coverage stated.`}
  jsonld={jsonld}
>
  <h1>BTC — Hyperliquid</h1>
  <p class="lede">Where forced selling sits, and how much of it is trapped.</p>

  <Answer q="Cannot defend their position" a={`${t.cannot_defend_pct}%`}>
    {usd(t.cannot_defend_usd)} of {usd(t.forced_notional_usd)} in forced exposure sits with wallets
    holding <strong>zero free collateral</strong>. They cannot move their liquidation price without
    depositing from outside.
    <Prov
      slot="prov"
      tier="observed"
      detail={`${t.wallets_in_band} positions read from the venue's own clearinghouse state`}
    />
  </Answer>

  <Grid>
    <Stat k="Nearest cluster" v={signed(near.distance_pct)} n={`${usd(near.notional_usd)} at ${Math.round(near.price).toLocaleString('en-US')}`} />
    <Stat k="Forced exposure" v={usd(t.forced_notional_usd)} n="within ±10%" />
    <Stat k="Market we can see" v={`${Math.round(cov.observed_fraction * 100)}%`} n={`${cov.wallets_scanned} wallets · ${cov.tier} tier`} />
    <Stat k="Map age" v={age(m.map_age_seconds)} n="since the last scan" />
  </Grid>

  <Note title="What happens if a cluster is reached?">
    Our research found <strong>no evidence</strong> that it moves price beyond ordinary volatility.
    Forced flow at 15 minutes returned +40.07 bps — and a random minute in the same hour returned
    44.52 bps.
    <a href={url('research/liquidations-dont-move-price.html')}>The full test →</a>
  </Note>

  <h2>Clusters</h2>
  <p class="lede"><Prov tier="calculated" detail="0.5% buckets, ±10% of the map's spot" /></p>
  <Scroll>
    <table>
      <thead>
        <tr><th>Distance</th><th>Price</th><th>Side</th><th>Exposure</th><th>Wallets</th>
        <th>Cannot defend</th></tr>
      </thead>
      <tbody>
        {m.clusters.map((c) => (
          <tr>
            <td>{signed(c.distance_pct)}</td>
            <td>{Math.round(c.price).toLocaleString('en-US')}</td>
            <td class={c.side}>{c.side}</td>
            <td>
              {usd(c.notional_usd)}{' '}
              <span class="bar" style={`width:${Math.max(1, Math.round((c.notional_usd / widest) * 54))}px`} />
            </td>
            <td>{c.wallets}</td>
            <td>{Math.round(c.cannot_defend_pct)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </Scroll>

  <h2>What we cannot see</h2>
  <ul class="plain">
    <li>{Math.round((1 - cov.observed_fraction) * 100)}% of open interest — wallets outside this scan</li>
    <li>cross-margin effects from positions in other assets</li>
    <li>anything that changed in the last {age(m.map_age_seconds)}</li>
  </ul>
  <p style="margin-top:.8rem"><a href={url('methodology.html')}>How every number here is produced →</a></p>
</Base>
