---
/**
 * The shell every page wears: head, nav, main, footer.
 *
 * The nav's Alerts entry appears only when a bot handle exists, so the site never links a door
 * that does not open. That check happens once, here, instead of in every page.
 */
import { botHandle, url } from '../lib/data';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** JSON-LD, so an agent can cite a figure with its method rather than parsing a chart. */
  jsonld?: Record<string, unknown>;
}
const { title, description, jsonld } = Astro.props;
const bot = botHandle();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Without these a shared link renders as a bare URL. The alert bot sends links all day and
        every one of them was a wasted impression. The card is regenerated with the data, so it
        always carries a live number and its coverage. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Isobath" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url('og.png'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(url('og.png'), Astro.site).href} />
    {jsonld && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <nav class="nav">
      <a class="brand" href={url('index.html')}>Isobath</a>
      <a href={url('check.html')}>Check a wallet</a>
      {bot && <a href={url('alerts.html')}>Alerts</a>}
      <a href={url('markets/btc.html')}>Markets</a>
      <a href={url('research/index.html')}>Research</a>
      <a href={url('record.html')}>Record</a>
      <a href={url('methodology.html')}>Methodology</a>
      <a href={url('api.html')}>API</a>
    </nav>
    <main class="wrap"><slot /></main>
    <footer class="wrap foot">
      <p>
        <strong>Isobath</strong> — an isobath is a chart line joining points of equal depth. It is
        what a navigator reads to know how much water is left under them.
      </p>
      <p>
        Every number here carries its provenance, its observation count and how much of the market
        we could see. <a href={url('record.html')}>Including the claims we got wrong.</a>
        Measurements come from Genesis, the research engine behind it.
      </p>
    </footer>
  </body>
</html>
