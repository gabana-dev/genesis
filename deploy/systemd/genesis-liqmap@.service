[Unit]
# One LIQ-2 scan. %i is the tier: fast (top 300 by notional, hourly) or deep (whole frozen
# universe, 6-hourly, re-ranks the fast set).
Description=Genesis LIQ-2 scan (%i tier)
After=network-online.target

[Service]
Type=oneshot
User=genesis
Group=genesis
WorkingDirectory=/opt/genesis
# scan.sh wraps flock: the two tiers share the fast set and the archive, and systemd alone only
# prevents a unit overlapping ITSELF. The wrapper exists so a lock skip and a real failure cannot
# produce the same journal line -- see deploy/scan.sh.
ExecStart=/opt/genesis/scan.sh %i
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/genesis/genesis-evidence
